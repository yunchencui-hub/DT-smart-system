{
  "name": "robin-build-guide",
  "version": "1.0.0",
  "private": true,
  "description": "Robin build-guide video (Remotion). Follows docs/04_assembly.md step by step.",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "faces": "tsx scripts/faces.ts",
    "netcheck": "tsx scripts/netcheck.ts",
    "review": "tsx scripts/review.ts",
    "voice": "tsx scripts/voice.ts",
    "voice:draft": "tsx scripts/voice.ts --draft",
    "stills": "tsx scripts/stills.ts",
    "render": "remotion render RobinBuildGuide out/robin_build_guide.mp4",
    "finish": "tsx scripts/finish.ts",
    "real": "tsx scripts/real-assets.ts",
    "real:stills": "tsx scripts/real-stills.ts",
    "real:studio": "remotion studio src/real/index.ts",
    "real:render": "remotion render src/real/index.ts RobinRealBuild out/robin_real_build.mp4",
    "anatomy:prep": "tsx scripts/anatomy-assets.ts && tsx scripts/faces.ts",
    "anatomy:voice": "tsx scripts/voice.ts --script anatomy",
    "anatomy:voice:draft": "tsx scripts/voice.ts --script anatomy --draft",
    "anatomy:review": "tsx scripts/review.ts --script anatomy",
    "anatomy:stills": "tsx scripts/anatomy-stills.ts",
    "anatomy:studio": "remotion studio src/anatomy/index.ts",
    "anatomy:render": "remotion render src/anatomy/index.ts RobinAnatomyBuild out/robin_anatomy_build.mp4",
    "anatomy:finish": "tsx scripts/finish.ts --script anatomy",
    "debug:voice": "tsx scripts/voice.ts --script debug",
    "debug:voice:draft": "tsx scripts/voice.ts --script debug --draft",
    "debug:review": "tsx scripts/review.ts --script debug",
    "debug:stills": "tsx scripts/anatomy-stills.ts --script debug",
    "debug:studio": "remotion studio src/anatomy/debug/index.ts",
    "debug:render": "remotion render src/anatomy/debug/index.ts RobinAnatomyDebug out/robin_anatomy_debug.mp4",
    "debug:finish": "tsx scripts/finish.ts --script debug",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.531",
    "@remotion/cli": "4.0.531",
    "@remotion/fonts": "4.0.531",
    "@remotion/renderer": "4.0.531",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.531"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.1.8",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
